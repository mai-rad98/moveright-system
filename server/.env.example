# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=5000
MONGO_URI=m
JWT_SECRET=change-me-to-a-long-random-string
# Website addresses allowed to call the API, comma separated (empty = allow all, for local testing)
CORS_ORIGIN=
# --- First admin (created on first start only) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email Quotes: Gmail support inbox ---
# Needs 2-Step Verification on the account, then Google Account > Security > App passwords
SMTP_USER=
SMTP_PASS=

MAIL_FROM_NAME=MoveRight Support
# How often to check Gmail for customer replies (seconds)
IMAP_POLL_SECONDS=120
# Shared secret: the website server sends this with every quote. Generate with: openssl rand -hex 32
WEBSITE_API_KEY=change-me-to-a-long-random-string

# --- Optional: PDFs ---
C
